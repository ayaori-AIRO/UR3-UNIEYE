<?xml version="1.0"?>
<package format="3">
  <name>ur3_moveit_examples</name>
  <version>0.1.0</version>
  <description>Minimal MoveIt 2 examples for a real UR3.</description>
  <maintainer email="user@example.com">UR3 user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ur_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>realsense2_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
