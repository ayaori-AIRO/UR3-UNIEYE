<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur">
  <xacro:arg name="name" default="ur"/>
  <!-- Keep the installed UR hardware and joint configuration unchanged. -->
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d405.urdf.xacro"/>

  <!-- Provisional tool0 -> camera_link transform, NOT hand-eye calibration.
       Units: metres/radians. Camera body +X looks along tool0 +Z. -->
  <!-- Photo-based provisional housing centre: 52.5 mm up,
       zero sideways offset in the upright camera basis. Compensates the
       official collision-box centre (-0.0078, -0.009, 0) from camera_link.
       Official visual front plate is +0.0038 m along camera_link +X.
       Add a provisional 2 mm rearward visual adjustment to the nominal
       -0.0038 m placement. This is not a measured calibration offset.
       Values below are expressed in tool0, not in world coordinates. -->
  <xacro:arg name="camera_xyz" default="-0.0480961272 -0.0228913204 -0.0058"/>
  <!-- Provisional upright alignment at the supplied teaching pose:
       base_link -> tool0 quaternion (x,y,z,w):
       0.682646 0.158293 -0.660869 -0.268681.
       Assumes base_link +Z is up. This is a constant mounting offset,
       NOT active levelling and NOT a measured hand-eye transform. -->
  <xacro:arg name="camera_rpy" default="0.6140009093 -1.5707963267948966 0"/>
  <link name="d405_mount"/>
  <joint name="tool0_d405_mount" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="d405_mount"/>
    <origin xyz="$(arg camera_xyz)" rpy="$(arg camera_rpy)"/>
  </joint>

  <!-- Cancel the official bottom-screw -> camera_link offset so that
       camera_link coincides with d405_mount, not the housing centre.
       Optical frames are published ONLY by the real camera driver. -->
  <xacro:sensor_d405 parent="d405_mount" name="camera" use_nominal_extrinsics="false">
    <origin xyz="-0.01085 -0.009 -0.021" rpy="0 0 0"/>
  </xacro:sensor_d405>
</robot>
